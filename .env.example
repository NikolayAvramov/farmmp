# Копирай в .env.local за локална разработка.
#
# Netlify: Site configuration → Environment variables → добави двете по-долу
# → Trigger deploy (Clear cache and deploy), за да влязат NEXT_PUBLIC_* в build-а.
#
# Vercel: Settings → Environment Variables (същите имена).
#
# Стойности: Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# В Supabase таблицата се казва „anon“ / „public“ — постави я под това име:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
